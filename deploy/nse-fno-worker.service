[Unit]
Description=NSE F&O scanner worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nse-fno-scanner
ExecStart=/opt/nse-fno-scanner/.venv/bin/python -m nse_scanner.worker
Restart=on-failure
RestartSec=5
User=nse-scanner
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
